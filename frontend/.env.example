# Frontend configuration (copy to frontend/.env.local)

# REST API base URL of the FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket base URL of the FastAPI backend (ws:// or wss://)
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Optional STUN server override (must match the backend STUN_SERVER)
# NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302

# Optional TURN server configuration for cross-network connectivity (Symmetric NAT traversal)
# NEXT_PUBLIC_TURN_SERVER=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=scaler_turn_user
# NEXT_PUBLIC_TURN_CREDENTIAL=scaler_turn_secret
# Optional raw JSON override for complete ICE configuration
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"password"}]

# Optional Clerk publishable key (bonus auth). Leave unset for mock-user mode.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
