# Root environment overview.
# The apps read their own env files:
#   backend/  -> backend/.env   (see backend/.env.example)
#   frontend/ -> frontend/.env.local (see frontend/.env.example)

# --- Backend (backend/.env) ---
# DATABASE_URL=sqlite:///./scaler.db
# CORS_ORIGINS=http://localhost:3000
# STUN_SERVER=stun:stun.l.google.com:19302
# CLERK_SECRET_KEY=          # optional bonus auth; leave unset for mock-user mode
# CLERK_ISSUER=              # e.g. https://your-app.clerk.accounts.dev

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
# NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # optional bonus auth
