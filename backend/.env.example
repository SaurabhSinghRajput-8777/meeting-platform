# Backend configuration (copy to backend/.env)
# SQLite database file (anchored to the backend directory when relative)
DATABASE_URL=sqlite:///./scaler.db

# Comma-separated list of allowed CORS origins (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# STUN server used for WebRTC NAT traversal (served to clients via this backend's config)
STUN_SERVER=stun:stun.l.google.com:19302

# Optional TURN server configuration for symmetric NAT traversal across different networks
# TURN_SERVER=turn:turn.example.com:3478
# TURN_USERNAME=scaler_turn_user
# TURN_CREDENTIAL=scaler_turn_secret
# Optional raw JSON override for multiple STUN/TURN servers (Coturn, Metered, Twilio, Xirsys)
# ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"user","credential":"pass"}]

# Optional Clerk bonus authentication.
# Leave these unset to run in mock/default-user mode.
# CLERK_SECRET_KEY=sk_test_...
# CLERK_ISSUER=https://your-app.clerk.accounts.dev

